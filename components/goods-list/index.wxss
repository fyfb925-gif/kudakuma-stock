.goods-list-wrap { display: flex; flex-flow: row wrap; justify-content: space-between; background: #f5f5f5; }
.inventory-card { width: calc(50% - 8rpx); margin-bottom: 16rpx; overflow: hidden; border-radius: 12rpx; background: #fff; }
.inventory-card__image { width: 100%; height: 330rpx; display: block; }
.inventory-card__body { padding: 20rpx; }
.inventory-card__brand { color: #777; font-size: 24rpx; }
.inventory-card__name { min-height: 72rpx; margin-top: 8rpx; font-size: 28rpx; font-weight: 600; line-height: 36rpx; }
.inventory-card__meta { margin-top: 10rpx; color: #888; font-size: 22rpx; }
.inventory-card__footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.inventory-card__price { color: #d54941; font-size: 32rpx; font-weight: 600; }
.inventory-card__stock { padding: 4rpx 10rpx; border-radius: 6rpx; font-size: 22rpx; }
.inventory-card__stock--ready { color: #2b7a4b; background: #e8f5ee; }
.inventory-card__stock--empty { color: #888; background: #eee; }
