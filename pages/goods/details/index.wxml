<view class="detail-page">
  <t-swiper
    wx:if="{{details.images.length}}"
    height="750rpx"
    list="{{details.images}}"
    navigation="{{navigation}}"
    bind:click="showCurImg"
  />
  <view class="product-card">
    <view class="brand">{{details.brand}}</view>
    <view class="name">{{details.name}}</view>
    <view class="price">人民币 ¥{{details.priceRmb}}</view>
    <view class="stock-row">
      <t-tag theme="{{details.stock === 0 ? 'default' : 'success'}}" variant="light">{{details.stockStatus}}</t-tag>
      <text>库存数量：{{details.stock}}</text>
    </view>
  </view>
  <view class="info-card">
    <view class="section-title">商品信息</view>
    <view class="info-row"><text>商品编号</text><text>{{details.productId}}</text></view>
    <view class="info-row"><text>品牌</text><text>{{details.brand}}</text></view>
    <view class="info-row"><text>型号</text><text>{{details.model}}</text></view>
    <view class="info-row"><text>颜色</text><text>{{details.color}}</text></view>
    <view class="info-row"><text>尺码</text><text>{{details.size}}</text></view>
  </view>
  <view class="info-card description">
    <view class="section-title">简单介绍</view>
    <view>{{details.description}}</view>
  </view>
  <view class="bottom-placeholder" />
  <view class="bottom-actions">
    <t-button block variant="outline" bindtap="copyProductId">复制商品编号</t-button>
    <t-button block theme="primary" bindtap="consultPurchase">咨询购买</t-button>
  </view>
</view>
