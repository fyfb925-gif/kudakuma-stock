page { background: #f5f5f5; }
.product-card, .info-card { margin-top: 16rpx; padding: 32rpx; background: #fff; }
.brand { color: #777; font-size: 26rpx; }
.name { margin-top: 10rpx; font-size: 38rpx; font-weight: 700; }
.price { margin-top: 24rpx; color: #d54941; font-size: 42rpx; font-weight: 700; }
.stock-row { display: flex; gap: 24rpx; align-items: center; margin-top: 22rpx; color: #555; }
.section-title { margin-bottom: 18rpx; font-size: 32rpx; font-weight: 600; }
.info-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eee; color: #666; }
.info-row text:last-child { color: #222; }
.description { line-height: 1.7; color: #555; }
.bottom-placeholder { height: 150rpx; }
.bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; gap: 20rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.08); }
.bottom-actions t-button { flex: 1; }
