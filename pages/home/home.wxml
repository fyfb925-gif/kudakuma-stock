<view class="home-page-header">
  <view class="search" bindtap="navToSearchPage">
    <t-search placeholder="搜索品牌、型号、尺码或商品编号" disabled />
  </view>
  <view class="inventory-hero">
    <view class="inventory-hero__title">果熊库存</view>
    <view class="inventory-hero__desc">日本骑行装备 · 人民币价格 · 库存实时展示</view>
  </view>
</view>
<view class="home-page-container">
  <view class="section-title">当前库存</view>
  <goods-list goodsList="{{goodsList}}" bind:click="goodListClickHandle" />
  <t-loading wx:if="{{pageLoading}}" theme="circular" text="加载中..." />
</view>
